# Copy this file to the service-specific .env files referenced by docker-compose.yml.

# MongoDB Atlas connection string with password placeholder.
# Put the real password inside <password>.
SPRING_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=CTSE-assignment
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=CTSE-assignment

# Set this per service in the matching .env file.
SPRING_MONGODB_DATABASE=authdb

# Shared secrets
JWT_SECRET=replace-with-a-long-random-secret

# Auth service bootstrap admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=change-this-password
ADMIN_FULL_NAME=System Admin

# Optional service URLs for local overrides
SERVICE_AUTH_URL=http://auth-service:8081
SERVICE_CATALOG_URL=http://catalog-service:8082
SERVICE_ORDER_URL=http://order-service:8083
SERVICE_PAYMENT_URL=http://payment-service:8084